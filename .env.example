# 🌍 ENVIRONMENT
APP_ENV=qa # qa | prod | dev

### 🌐 WEB APP CONFIGURATION ###

# 🔗 WEB APP URL
WEB_APP_URL=http://localhost/opencart/upload/
#WEB_APP_URL=https://tutorialsninja.com/demo/
#WEB_APP_URL=https://awesomeqa.com/ui/

# 🔐 WEB APP LOGIN CREDENTIALS (CREATE YOUR OWN CREDENTIALS)
APP_EMAIL=
APP_PASSWORD=

# 🛒 PRODUCT DETAILS
PRODUCT_NAME=MacBook
PRODUCT_QUANTITY=1
TOTAL_PRICE=$602.00

### 🔌 API CONFIGURATION ###

# 🔗 API BASE URL
API_BASE_URL=https://fakestoreapi.com

# 👤 API USER DETAILS
USERNAME=
PASSWORD=
USER_ID=

# 🛍️ API PRODUCT DETAILS
PRODUCT_ID=1
CART_ID=1
LIMIT=3

# 📅 DATE RANGE
START_DATE=2019-12-10
END_DATE=2020-10-10
# 🔑 BASIC AUTHENTICATION CREDENTIALS (IF REQUIRED)
#BASIC_AUTH_USERNAME=YOUR_USERNAME
#BASIC_AUTH_PASSWORD=YOUR_PASSWORD

# 🔐 API KEY (IF REQUIRED)
#API_KEY=YOUR_API_KEY

# 🎟️ ACCESS TOKEN (IF REQUIRED)
#ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN

# 🔄 OAUTH2 CONFIGURATION (IF REQUIRED)
#CLIENT_ID=YOUR_CLIENT_ID
#CLIENT_SECRET=YOUR_CLIENT_SECRET
#AUTHORIZATION_CODE=YOUR_AUTHORIZATION_CODE
#TOKEN_URL=YOUR_TOKEN_URL

### 🗄️ DATABASE CONFIGURATION ###

# 🖥️ DATABASE CONNECTION
DB_HOST=localhost
DB_USER=opencart_test
DB_PASSWORD=
DB_NAME=openshop
DB_PORT=3306

# 👨‍💼 ADMIN APP LOGIN CREDENTIALS
ADMIN_USERNAME=
ADMIN_PASSWORD=


# Docker: required when initializing a NEW MySQL volume. Store this in CI Secrets.
# Changing it does not rotate the password in an existing database.
OPENCART_DB_ROOT_PASSWORD=
# Optional non-sensitive installer address; no real inbox is needed.
OPENCART_ADMIN_EMAIL=admin@example.test
# Compose inherits DB_*, APP_*, and ADMIN_* above unless OPENCART_* overrides are set.
